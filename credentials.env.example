# credentials.env — cluster login credentials and cloud keys.
# Copy this file to credentials.env and fill in the values.
# credentials.env is gitignored and MUST NOT be committed.

# --- OpenShift clusters ---
# HUB: the ACM hub cluster (manages spokes, DR pairs, protection groups)
HUB_USER="admin"
HUB_PASS=""
HUB_API="https://api.<hub-cluster>.<domain>:443"

# ARO: Azure Red Hat OpenShift spoke cluster
ARO_USER="kubeadmin"
ARO_PASS=""
ARO_API="https://api.<aro-cluster>.<region>.aroapp.io:6443"

# ROSA: Red Hat OpenShift Service on AWS spoke cluster
ROSA_USER="admin"
ROSA_PASS=""
ROSA_API="https://api.<rosa-cluster>.<id>.p3.openshiftapps.com:443"

# GCP: OpenShift Dedicated on GCP spoke cluster
GCP_USER="cluster-admin"
GCP_PASS=""
GCP_API="https://api.<gcp-cluster>.<id>.p2.openshiftapps.com:6443"

# ONPREM: on-premises OpenShift spoke cluster
ONPREM_USER="kubeadmin"
ONPREM_PASS=""
ONPREM_API="https://api.<onprem-cluster>.<domain>:6443"

# --- S3 object store (Portworx DR backup location) ---
S3_BUCKET=""          # bucket name for Portworx DR backups
S3_REGION=""          # e.g. us-east-1 or ap-southeast-2
S3_ENDPOINT=""        # e.g. s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=""      # IAM access key with S3 read/write
S3_SECRET_KEY=""      # IAM secret key

# --- Azure (Portworx on ARO — service principal for cloud drives) ---
AZURE_CLIENT_ID=""    # Azure AD app registration client ID
AZURE_CLIENT_SECRET=""# Azure AD app registration client secret

# --- Portworx license ---
PX_LICENSE_KEY=""     # Portworx Enterprise or Essentials license key
